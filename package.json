{
  "name": "@nomideusz/svelte-notify",
  "version": "1.1.0",
  "description": "Email notification template library for the @nomideusz booking platform.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "default": "./dist/transport/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "package": "svelte-kit sync && svelte-package",
    "prepublishOnly": "npm run package",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nomideusz/svelte-i18n": "^1.0.0",
    "@nomideusz/svelte-qr": "^1.0.0"
  },
  "peerDependencies": {
    "@types/nodemailer": ">=6",
    "nodemailer": "^9.0.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    },
    "@types/nodemailer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/nodemailer": "^8.0.1",
    "nodemailer": "^9.0.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "svelte",
    "email",
    "notifications",
    "templates",
    "booking"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nomideusz/svelte-notify"
  },
  "homepage": "https://svelte-notify.vercel.app/"
}
